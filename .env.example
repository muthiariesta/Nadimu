# Salin file ini jadi .env.local lalu isi nilainya

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia, hanya dipakai di API route (jangan diberi prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Resend: resend.com -> API Keys
RESEND_API_KEY=
# Sandbox Resend (onboarding@resend.dev) cuma bisa kirim ke email pemilik akun Resend.
# Isi dengan email itu saat demo; kosongkan kalau sudah pakai domain terverifikasi.
EMAIL_DEMO_TO=
